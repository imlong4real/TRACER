#!/bin/bash
#$ -S /bin/bash
#$ -N tracer_gbm_npmi
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe smp 4
#$ -l h_rt=24:00:00
#$ -l mem_free=64G

set -euo pipefail

# gbm-branch worktree: REPO is TRACER-gbm (its own code). The gitignored
# tracer_latest.sif, data/ and output/ are symlinks back to the canonical TRACER/
# checkout, so $REPO-relative paths resolve.
REPO=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/code/TRACER-gbm
SIF=$REPO/tracer_latest.sif
# Transcripts the NPMI panel is learned from (a representative sample).
INPUT=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/data/xenium/output-XETG00323__0023274__Patient4__20241004__181038/transcripts.parquet
OUTPUT=$REPO/tutorials/gbm/data/gbm_npmi.csv

mkdir -p "$REPO/logs" "$REPO/tutorials/gbm/data"

source /mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3/etc/profile.d/conda.sh
conda activate segmentation

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=${NSLOTS:-1}
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

cd "$REPO"

apptainer exec \
    --bind "$REPO/tutorials":/app/tutorials \
    --bind /mnt/storage:/mnt/storage \
    --pwd /app \
    "$SIF" \
    python tutorials/gbm/generate_npmi.py \
        --input "$INPUT" \
        --output /app/tutorials/gbm/data/gbm_npmi.csv \
        --qv-min 30 \
        --low-pct 20 \
        --high-pct 80 \
        --seed 1
