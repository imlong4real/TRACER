#!/bin/bash
#$ -S /bin/bash
#$ -N tracer_gbm_compare
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe smp 4
#$ -l h_rt=24:00:00
#$ -l mem_free=128G

set -euo pipefail

# gbm-branch worktree: REPO is TRACER-gbm (its own code). The gitignored
# tracer_latest.sif, data/ and output/ are symlinks back to the canonical TRACER/
# checkout, so $REPO-relative paths resolve on the host. NOTE: the data/ and
# output/ symlinks are RELATIVE, so they DON'T resolve inside the container —
# see the readlink -f block below.
#
# Two-stage split so downstream deps stay out of the core container:
#   - Steps 1-2 (merge + metrics/QC) run in the Apptainer container (need tracer).
#   - Step 3 (Leiden/UMAP/markers) runs in the insitucnv_env conda env (needs
#     igraph/leidenalg, which the pulled tracer_latest.sif lacks).
REPO=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/code/TRACER-gbm
SIF=$REPO/tracer_latest.sif

# output/ and data/ are RELATIVE symlinks (../../../TRACER/...) that resolve on
# the host but DANGLE inside the container: only /app/tutorials and /mnt/storage
# are bound, so /app/tutorials/gbm/output -> /TRACER/... which does not exist.
# Resolve them on the host to their real /mnt/storage paths, which ARE bound
# identically in the container, and pass THOSE to apptainer instead of /app/... .
OUT_REAL=$(readlink -f "$REPO/tutorials/gbm/output")
DATA_REAL=$(readlink -f "$REPO/tutorials/gbm/data")
[[ "$OUT_REAL" == /mnt/storage/* && "$DATA_REAL" == /mnt/storage/* ]] || {
    echo "Resolved output/data escape the /mnt/storage bind: $OUT_REAL / $DATA_REAL" >&2
    exit 1
}

MANIFEST=$OUT_REAL/slide3_pieces/piece_run_manifest.csv
NPMI=$DATA_REAL/gbm_npmi_no_controls.csv
MERGED=$OUT_REAL/slide3_tracer_merged.parquet
OUTDIR=$OUT_REAL/slide3_profile_comparison
ANNOTATIONS=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/data/xenium/Xenium_Annotations/adata_obs_annotated.csv

if [[ ! -f "$SIF" ]]; then
    echo "Missing Apptainer container: $SIF" >&2
    exit 1
fi
if [[ ! -f "$MANIFEST" ]]; then
    echo "Missing piece run manifest: $MANIFEST" >&2
    exit 1
fi
if [[ ! -f "$NPMI" ]]; then
    echo "Missing NPMI file: $NPMI" >&2
    exit 1
fi

mkdir -p "$REPO/logs" "$OUTDIR"

source /mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3/etc/profile.d/conda.sh
conda activate segmentation

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=${NSLOTS:-4}
export OPENBLAS_NUM_THREADS=${NSLOTS:-4}
export MKL_NUM_THREADS=${NSLOTS:-4}
export NUMEXPR_NUM_THREADS=${NSLOTS:-4}

cd "$REPO"

echo "=== Step 1: Merging TRACER piece parquets [container] ==="
apptainer exec \
    --bind "$REPO/tutorials":/app/tutorials \
    --bind /mnt/storage:/mnt/storage \
    --pwd /app \
    "$SIF" \
    python tutorials/gbm/merge_slide3_tracer.py \
        --manifest "$MANIFEST" \
        --tracer-dir "$OUT_REAL/slide3_tracer" \
        --output "$MERGED"

echo "=== Step 2: Prep — build AnnData + purity/conflict + QC [container] ==="
apptainer exec \
    --bind "$REPO/tutorials":/app/tutorials \
    --bind /mnt/storage:/mnt/storage \
    --pwd /app \
    "$SIF" \
    python tutorials/gbm/compare_profiles.py \
        --stage prep \
        --input "$MERGED" \
        --npmi "$NPMI" \
        --outdir "$OUTDIR" \
        --annotations-csv "$ANNOTATIONS"

echo "=== Step 3: Cluster — scanpy (Leiden/UMAP/markers) [insitucnv_env] ==="
conda activate insitucnv_env
python tutorials/gbm/compare_profiles.py \
    --stage cluster \
    --outdir "$OUTDIR"

echo "=== Done. Outputs written to $OUTDIR ==="
