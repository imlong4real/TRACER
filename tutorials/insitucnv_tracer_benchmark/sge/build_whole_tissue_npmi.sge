#!/bin/bash
#$ -S /bin/bash
#$ -N insitucnv_tracer_npmi
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe smp 4
#$ -l h_rt=72:00:00
#$ -l mem_free=128G

# Build the DENSE whole-tissue nuclear PMI/NPMI panel that TRACER consumes.
#
# Runs INSIDE tracer_latest.sif (Apptainer) because it calls
# tracer.metrics.compute_pmi_bootstrap. Only the container-invocation pattern is
# borrowed from tutorials/gbm; the NPMI logic is fresh (nuclear transcripts +
# matrix counts= path). See build_whole_tissue_npmi.py for the rationale.
#
# Submit:
#   qsub tutorials/insitucnv_tracer_benchmark/sge/build_whole_tissue_npmi.sge
#
# DEFAULT is a representative 100k-nuclear-cell subsample (fast, dense, and a
# sound whole-tissue population estimate). To learn PMI from EVERY nuclear cell
# (all ~1.16M; slower, and the 1.16M x ~5k bootstrap is the genuine runtime/OOM
# unknown), submit with SUBSAMPLE=0:
#   qsub -v SUBSAMPLE=0 .../build_whole_tissue_npmi.sge
# Other overrides: QV_MIN, MIN_OCC, SEED, MAX_BOOTSTRAPS.

set -euo pipefail

REPO=${REPO:-/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/code/TRACER}
REPO=$(readlink -f "$REPO")
SIF=${SIF:-$REPO/tracer_latest.sif}
BENCH=$REPO/tutorials/insitucnv_tracer_benchmark

if [[ ! -f "$SIF" ]]; then
    echo "Missing TRACER container: $SIF" >&2
    echo "Set SIF=/path/to/tracer_latest.sif or place tracer_latest.sif under \$REPO." >&2
    exit 1
fi
SIF=$(readlink -f "$SIF")

# Resolve symlinks so container-side paths match host paths (see MEMORY:
# "Container symlink binds"): bind the real /mnt/storage tree, use absolute paths.
TRANSCRIPTS=${TRANSCRIPTS:-$BENCH/data/xenium_ovary/raw/Xenium_Prime_Human_Ovary_FF_transcripts.parquet}
TRANSCRIPTS=$(readlink -f "$TRANSCRIPTS")
OUT=${OUT:-$BENCH/data/whole_tissue_npmi.csv.gz}
mkdir -p "$(dirname "$OUT")"
OUT_DIR=$(readlink -f "$(dirname "$OUT")")
OUT=$OUT_DIR/$(basename "$OUT")
ROI=${ROI:-$BENCH/data/roi_transcripts.parquet}   # for the per-seed acceptance check
ROI=$(readlink -f "$ROI")

QV_MIN=${QV_MIN:-20}
MIN_OCC=${MIN_OCC:-1}
SUBSAMPLE=${SUBSAMPLE:-100000}     # representative whole-tissue sample; SUBSAMPLE=0 => all cells
SEED=${SEED:-1}
MAX_BOOTSTRAPS=${MAX_BOOTSTRAPS:-200}

mkdir -p "$REPO/logs" "$(dirname "$OUT")"
cd "$REPO"

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=${NSLOTS:-1}
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

APPTAINER_CONDA_BASE=${APPTAINER_CONDA_BASE:-/mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3}
APPTAINER_CONDA_ENV=${APPTAINER_CONDA_ENV:-segmentation}
source "$APPTAINER_CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$APPTAINER_CONDA_ENV"
if ! command -v apptainer >/dev/null 2>&1; then
    echo "apptainer not found after conda activate $APPTAINER_CONDA_ENV" >&2
    exit 127
fi

echo "Transcripts : $TRANSCRIPTS"
echo "Out         : $OUT"
echo "qv_min=$QV_MIN min_occ=$MIN_OCC subsample=$SUBSAMPLE seed=$SEED max_bootstraps=$MAX_BOOTSTRAPS"

apptainer exec \
    --bind /mnt/storage:/mnt/storage \
    --pwd "$REPO" \
    "$SIF" \
    python tutorials/insitucnv_tracer_benchmark/scripts/build_whole_tissue_npmi.py \
        --transcripts "$TRANSCRIPTS" \
        --out "$OUT" \
        --qv-min "$QV_MIN" \
        --min-occurrences "$MIN_OCC" \
        --subsample-cells "$SUBSAMPLE" \
        --max-bootstraps "$MAX_BOOTSTRAPS" \
        --seed "$SEED" \
        --show-progress

# Acceptance gate: per-seed positive-PMI support on the ROI (the exact GBM
# over-pruning postmortem check). A HEALTHY verdict here is the go/no-go BEFORE
# the expensive TRACER run — global panel positivity is not sufficient.
apptainer exec \
    --bind /mnt/storage:/mnt/storage \
    --pwd "$REPO" \
    "$SIF" \
    python tutorials/insitucnv_tracer_benchmark/scripts/check_panel_seed_support.py \
        --panel "$OUT" \
        --transcripts "$ROI" \
        --qv-min "$QV_MIN" \
        --out "$OUT.seed_support.json"
