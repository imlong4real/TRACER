#!/bin/bash
#$ -S /bin/bash
#$ -N insitucnv_tracer_cpmi
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe smp 4
#$ -l h_rt=72:00:00
#$ -l mem_free=128G

# Build a subsampled whole-tissue CPMI panel for TRACER.
#
# Default:
#   qsub tutorials/insitucnv_tracer_benchmark/sge/build_whole_tissue_cpmi.sge
# writes:
#   data/whole_tissue_cpmi_nuclear_50k.csv.gz
#
# Whole-cell comparison:
#   qsub -v COUNT_SCOPE=whole_cell tutorials/insitucnv_tracer_benchmark/sge/build_whole_tissue_cpmi.sge
# writes:
#   data/whole_tissue_cpmi_whole_cell_50k.csv.gz
#
# Common overrides:
#   COUNT_SCOPE=nuclear|whole_cell, SUBSAMPLE=50000, QV_MIN=20, MIN_OCC=1,
#   MIN_DET_CELLS=25, TOP_K_PER_GENE=200, PANEL_GENES=/path/genes.txt,
#   MAX_ROW_GROUPS=10, DRY_RUN=1, OUT=/path/panel.csv.gz.
#
# Staging mode (STAGE_ONLY=1) writes no panel. It streams the eligible
# transcripts of the subsampled cells to a small parquet for the canonical
# builder, scripts/build_panels.py, whose loader cannot ingest the 33.7 GB
# whole-slide table. This is the first step of the grid3 + cPMI path:
#
#   qsub -v STAGE_ONLY=1                       .../build_whole_tissue_cpmi.sge
#   qsub -v STAGE_ONLY=1,COUNT_SCOPE=whole_cell .../build_whole_tissue_cpmi.sge
# write:
#   data/staged_nuclear_50k.parquet
#   data/staged_whole_cell_50k.parquet
#
# Staging overrides: STAGE_OUT=/path/staged.parquet.
#
# RUNTIME=conda|container selects the interpreter. Staging imports only
# pyarrow/pandas/numpy -- never `tracer` (the --stage-only branch returns
# before load_cpmi_builder()) -- so it defaults to `conda` and needs no
# container at all. The panel path defaults to `container` because it calls
# tracer.conflict_reference. Override with RUNTIME=...
#
# Under RUNTIME=conda the env is entered with `conda activate`, matching
# make_full_ovary_celltyping.sge: BENCH_ENV names it, CONDA_BASE locates the
# conda install, and BENCH_PYTHON=/path/to/bin/python is a last-resort escape
# hatch for when conda itself is unavailable.

set -euo pipefail

REPO=${REPO:-/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/code/TRACER}
REPO=$(readlink -f "$REPO")
SIF=${SIF:-$REPO/tracer_latest.sif}
BENCH=$REPO/tutorials/insitucnv_tracer_benchmark

# Staging is container-independent; the panel build is not. See the RUNTIME
# note in the header.
if [[ "${STAGE_ONLY:-0}" == "1" ]]; then
    RUNTIME=${RUNTIME:-conda}
else
    RUNTIME=${RUNTIME:-container}
fi
BENCH_ENV=${BENCH_ENV:-insitucnv_tracer_benchmark}
BENCH_PYTHON=${BENCH_PYTHON:-}
CONDA_BASE=${CONDA_BASE:-/mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3}

case "$RUNTIME" in
    container)
        if [[ ! -f "$SIF" ]]; then
            echo "Missing TRACER container: $SIF" >&2
            echo "Set SIF=/path/to/tracer_latest.sif or place tracer_latest.sif under \$REPO." >&2
            exit 1
        fi
        SIF=$(readlink -f "$SIF")
        ;;
    conda) ;;
    *)
        echo "RUNTIME must be conda or container, got: $RUNTIME" >&2
        exit 1
        ;;
esac

TRANSCRIPTS=${TRANSCRIPTS:-$BENCH/data/xenium_ovary/raw/Xenium_Prime_Human_Ovary_FF_transcripts.parquet}
TRANSCRIPTS=$(readlink -f "$TRANSCRIPTS")
ROI=${ROI:-$BENCH/data/roi_transcripts.parquet}
ROI=$(readlink -f "$ROI")

COUNT_SCOPE=${COUNT_SCOPE:-nuclear}
SUBSAMPLE=${SUBSAMPLE:-50000}
QV_MIN=${QV_MIN:-20}
MIN_OCC=${MIN_OCC:-1}
MIN_DET_CELLS=${MIN_DET_CELLS:-25}
N_DEPTH_BINS=${N_DEPTH_BINS:-25}
MIN_COOCCUR=${MIN_COOCCUR:-2}
MIN_EXPECTED_NEG=${MIN_EXPECTED_NEG:-5}
MAX_OBSERVED_NEG=${MAX_OBSERVED_NEG:-1}
NEG_RECOVERY_TOP_M=${NEG_RECOVERY_TOP_M:-2500}
TOP_K_PER_GENE=${TOP_K_PER_GENE:-}
PANEL_GENES=${PANEL_GENES:-}
MAX_ROW_GROUPS=${MAX_ROW_GROUPS:-0}
DRY_RUN=${DRY_RUN:-0}
STAGE_ONLY=${STAGE_ONLY:-0}
SEED=${SEED:-1}

if [[ -z "${OUT:-}" ]]; then
    if [[ "$SUBSAMPLE" == "0" ]]; then
        SUBSAMPLE_LABEL=all
    elif [[ "$SUBSAMPLE" == "50000" ]]; then
        SUBSAMPLE_LABEL=50k
    else
        SUBSAMPLE_LABEL=$SUBSAMPLE
    fi
    OUT=$BENCH/data/whole_tissue_cpmi_${COUNT_SCOPE}_${SUBSAMPLE_LABEL}.csv.gz
fi
mkdir -p "$(dirname "$OUT")"
OUT_DIR=$(readlink -f "$(dirname "$OUT")")
OUT=$OUT_DIR/$(basename "$OUT")

if [[ "$STAGE_ONLY" == "1" ]]; then
    if [[ -z "${STAGE_OUT:-}" ]]; then
        if [[ "$SUBSAMPLE" == "0" ]]; then
            STAGE_LABEL=all
        elif [[ "$SUBSAMPLE" == "50000" ]]; then
            STAGE_LABEL=50k
        else
            STAGE_LABEL=$SUBSAMPLE
        fi
        STAGE_OUT=$BENCH/data/staged_${COUNT_SCOPE}_${STAGE_LABEL}.parquet
    fi
    mkdir -p "$(dirname "$STAGE_OUT")"
    STAGE_DIR=$(readlink -f "$(dirname "$STAGE_OUT")")
    STAGE_OUT=$STAGE_DIR/$(basename "$STAGE_OUT")
fi
if [[ -n "$PANEL_GENES" ]]; then
    PANEL_GENES=$(readlink -f "$PANEL_GENES")
fi

mkdir -p "$REPO/logs" "$(dirname "$OUT")"
cd "$REPO"

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=${NSLOTS:-1}
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

APPTAINER_CONDA_BASE=${APPTAINER_CONDA_BASE:-/mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3}
APPTAINER_CONDA_ENV=${APPTAINER_CONDA_ENV:-segmentation}
if [[ "$RUNTIME" == "container" ]]; then
    source "$APPTAINER_CONDA_BASE/etc/profile.d/conda.sh"
    conda activate "$APPTAINER_CONDA_ENV"
    if ! command -v apptainer >/dev/null 2>&1; then
        echo "apptainer not found after conda activate $APPTAINER_CONDA_ENV" >&2
        exit 127
    fi
else
    # Enter the env the way conda intends, so the env's own activation hooks
    # and library paths apply; an explicit interpreter path is the fallback,
    # not the default. Mirrors make_full_ovary_celltyping.sge.
    if [[ -n "$BENCH_PYTHON" ]]; then
        PYTHON="$BENCH_PYTHON"
    elif command -v conda >/dev/null 2>&1; then
        set +u
        source "$(conda info --base)/etc/profile.d/conda.sh"
        conda activate "$BENCH_ENV"
        set -u
        PYTHON=python
    elif [[ -n "$CONDA_BASE" && -f "$CONDA_BASE/etc/profile.d/conda.sh" ]]; then
        set +u
        source "$CONDA_BASE/etc/profile.d/conda.sh"
        conda activate "$BENCH_ENV"
        set -u
        PYTHON=python
    else
        echo "Could not find conda in PATH or at CONDA_BASE=$CONDA_BASE." >&2
        echo "Submit with CONDA_BASE=/path/to/conda/base or BENCH_PYTHON=/path/to/env/bin/python." >&2
        exit 1
    fi
fi

# Single place that decides how python is invoked. Args are the script path
# followed by its own flags.
run_py() {
    if [[ "$RUNTIME" == "conda" ]]; then
        "$PYTHON" "$@"
    else
        apptainer exec \
            --bind /mnt/storage:/mnt/storage \
            --pwd "$REPO" \
            "$SIF" \
            python "$@"
    fi
}

echo "Transcripts         : $TRANSCRIPTS"
echo "Count scope         : $COUNT_SCOPE"
if [[ "$RUNTIME" == "conda" ]]; then
    echo "Runtime             : conda env '${CONDA_DEFAULT_ENV:-$BENCH_ENV}' ($(command -v $PYTHON))"
else
    echo "Runtime             : container ($SIF)"
fi
if [[ "$STAGE_ONLY" == "1" ]]; then
    echo "Mode                : STAGE_ONLY (no panel; feeds build_panels.py)"
    echo "Staged parquet      : $STAGE_OUT"
else
    echo "Out                 : $OUT"
fi
echo "ROI seed check      : $ROI"
echo "qv_min=$QV_MIN min_occ=$MIN_OCC subsample=$SUBSAMPLE min_det_cells=$MIN_DET_CELLS seed=$SEED"
echo "n_depth_bins=$N_DEPTH_BINS min_cooccur=$MIN_COOCCUR min_expected_neg=$MIN_EXPECTED_NEG max_observed_neg=$MAX_OBSERVED_NEG neg_recovery_top_m=$NEG_RECOVERY_TOP_M top_k_per_gene=${TOP_K_PER_GENE:-none}"
echo "panel_genes=${PANEL_GENES:-none} max_row_groups=$MAX_ROW_GROUPS dry_run=$DRY_RUN"

CPMI_ARGS=(
    tutorials/insitucnv_tracer_benchmark/scripts/build_whole_tissue_cpmi.py
    --transcripts "$TRANSCRIPTS"
    --out "$OUT"
    --count-scope "$COUNT_SCOPE"
    --qv-min "$QV_MIN"
    --min-occurrences "$MIN_OCC"
    --subsample-cells "$SUBSAMPLE"
    --min-det-cells "$MIN_DET_CELLS"
    --n-depth-bins "$N_DEPTH_BINS"
    --min-cooccur "$MIN_COOCCUR"
    --min-expected-neg "$MIN_EXPECTED_NEG"
    --max-observed-neg "$MAX_OBSERVED_NEG"
    --neg-recovery-top-m "$NEG_RECOVERY_TOP_M"
    --max-row-groups "$MAX_ROW_GROUPS"
    --seed "$SEED"
)

if [[ -n "$TOP_K_PER_GENE" && "$TOP_K_PER_GENE" != "0" ]]; then
    CPMI_ARGS+=(--top-k-per-gene "$TOP_K_PER_GENE")
fi
if [[ -n "$PANEL_GENES" ]]; then
    CPMI_ARGS+=(--panel-genes "$PANEL_GENES")
fi
if [[ "$DRY_RUN" == "1" ]]; then
    CPMI_ARGS+=(--dry-run)
fi
if [[ "$STAGE_ONLY" == "1" ]]; then
    CPMI_ARGS+=(--stage-only --stage-out "$STAGE_OUT")
fi

run_py "${CPMI_ARGS[@]}"

if [[ "$DRY_RUN" == "1" ]]; then
    echo "DRY_RUN=1: skipping ROI seed-support check because no panel was written."
    exit 0
fi

if [[ "$STAGE_ONLY" == "1" ]]; then
    echo "STAGE_ONLY=1: skipping ROI seed-support check because no panel was written."
    echo "Next: scripts/build_panels.py --transcripts $STAGE_OUT \\"
    echo "        --nucleus-only --panel-preset nuclear --emit-cpmi"
    exit 0
fi

# Acceptance gate: per-seed positive panel support on the ROI. For CPMI panels,
# the TRACER-compatible PMI column stores cPMI.
run_py tutorials/insitucnv_tracer_benchmark/scripts/check_panel_seed_support.py \
        --panel "$OUT" \
        --transcripts "$ROI" \
        --metric-col PMI \
        --qv-min "$QV_MIN" \
        --out "$OUT.seed_support.json"
