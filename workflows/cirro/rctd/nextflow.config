manifest {
    name = 'TRACER RCTD label transfer for Cirro'
    author = 'Deshpande Lab'
    homePage = 'https://github.com/imlong4real/TRACER'
    description = 'RCTD (spacexr) GBmap label transfer across pre- and post-TRACER entity arms'
    mainScript = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version = '0.1.0-rctd.1'
}

params {
    // Cirro injects the source (TRACER Seg output) dataset's dataPath.
    input_dir = null
    transcripts = null          // transcripts_tracer_refined.parquet, relative to input_dir
    reference = null            // panel-restricted GBmap reference h5ad (S3 reference path)

    sample_name = 'tracer_sample'
    patient = ''
    section = ''
    arms = 'original,post_whole,post_partial,post_all'

    // RCTD settings. Applied IDENTICALLY to every arm by construction: the
    // workflow has no per-arm override and the same values reach each task.
    celltype_col = 'gbmap_predicted__annotation_level_3'
    doublet_mode = 'full'
    umi_min = 10
    umi_min_sigma = 20
    gene_cutoff = 0.000125
    fc_cutoff = 0.5
    min_cells_per_celltype_reference = 25
    seed = 1

    cpus = 16
    memory_gb = 64
    max_memory_gb = 256
    prep_memory_gb = 96
    max_retries = 3
    outdir = 'results'

    tracer_source_commit = 'ee259003be572581c434dd5bed40d7568f05f906'
    analysis_container = 'ghcr.io/imlong4real/segbench-analysis@sha256:98985cd498937a651cb4c278d562452606c24a9bea7095d1eecd5c7fea6a42a3'
    spacexr_commit = '9f5dc33c8060f946c6072a138b70e189636e1435'
}

process {
    executor = 'local'
    container = params.analysis_container
    cpus = { params.cpus as int }
    memory = {
        def requested = (params.memory_gb as int) * task.attempt
        Math.min(requested, params.max_memory_gb as int).GB
    }
    time = { (24 * task.attempt).h }
    errorStrategy = { task.exitStatus in [104, 137, 143] ? 'retry' : 'terminate' }
    maxRetries = params.max_retries as int
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: RCTD_PREP {
        cpus = { Math.min(params.cpus as int, 8) }
        memory = {
            def requested = (params.prep_memory_gb as int) * task.attempt
            Math.min(requested, params.max_memory_gb as int).GB
        }
    }
    withName: RCTD_COLLECT {
        cpus = 2
        memory = { Math.min(16 * task.attempt, params.max_memory_gb as int).GB }
    }
}

docker { enabled = true }
singularity { enabled = false; autoMounts = true; cacheDir = "${baseDir}/.singularity" }

profiles {
    local { docker.enabled = false; singularity.enabled = false }
    docker { docker.enabled = true; singularity.enabled = false }
    singularity { docker.enabled = false; singularity.enabled = true }
    cirro { process.executor = 'awsbatch'; docker.enabled = true; singularity.enabled = false }
}

trace { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt"; overwrite = true }
report { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
dag { enabled = true; file = "${params.outdir}/pipeline_info/execution_dag.html"; overwrite = true }
