manifest {
    name = 'TRACER Seg for Cirro'
    author = 'Deshpande Lab'
    homePage = 'https://github.com/imlong4real/TRACER'
    description = 'Cirro adapter for deterministic TRACER segmentation refinement'
    mainScript = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version = '0.1.1-cirro.1'
}

params {
    transcripts = null
    pmi = null
    user_config = null
    cell_boundaries = null
    nucleus_boundaries = null

    sample_name = 'tracer_sample'
    platform = 'xenium'
    qv_min = null
    remove_control_probes = true
    drop_unassigned = false
    pmi_threshold = null
    g_z_um = null
    tau = null
    min_tx_per_cell_for_scores = 5
    score_mode = 'count'
    seed = 1

    cpus = 16
    memory_gb = 64
    max_memory_gb = 256
    max_retries = 3
    outdir = 'results'

    tracer_version = '0.1.1'
    tracer_source_commit = 'ee259003be572581c434dd5bed40d7568f05f906'
    tracer_oci_image = 'ghcr.io/imlong4real/tracer@sha256:1ab4e0b2704fad56237fb4a9099c4ecbd1d83c71a52b3738386e5fafca90d282'
    tracer_container = 'ghcr.io/imlong4real/tracer@sha256:1ab4e0b2704fad56237fb4a9099c4ecbd1d83c71a52b3738386e5fafca90d282'
}

process {
    executor = 'local'
    container = params.tracer_container
    cpus = { params.cpus as int }
    memory = {
        def requested = (params.memory_gb as int) * task.attempt
        Math.min(requested, params.max_memory_gb as int).GB
    }
    time = { (24 * task.attempt).h }
    errorStrategy = { task.exitStatus in [104, 137, 143] ? 'retry' : 'terminate' }
    maxRetries = params.max_retries as int
    shell = ['/bin/bash', '-euo', 'pipefail']
}

docker {
    enabled = true
}

singularity {
    enabled = false
    autoMounts = true
    cacheDir = "${baseDir}/.singularity"
}

profiles {
    local {
        docker.enabled = false
        singularity.enabled = false
    }
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    singularity {
        docker.enabled = false
        singularity.enabled = true
    }
    cirro {
        process.executor = 'awsbatch'
        docker.enabled = true
        singularity.enabled = false
    }
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_dag.html"
    overwrite = true
}
